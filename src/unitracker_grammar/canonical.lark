// The canonical unitracker document, format 2.0. A document names no player: everything it plays
// is in it, and its only constants are the note table F(k) (notes.py) at its clock.
// Whitespace is exact, but a space inside a flow collection or a block scalar may be a line wrap
// (a newline and the continuation indentation); a flow expression that contains a comma is
// written in single quotes. Every block line ends with its newline.
// The definitions that are not song content are top-level sections, records at 2 spaces: the
// templates (mod:, keyed by a SIGNATURE, an expression or a code block at 4 spaces), then
// restart:, ins:, ctrl:, pw: and filter:; a row's def: holds its phrases. A program record may
// be a template keyed by a PROGRAM_SIG whose rows read its parameters (PARAM, REL_PARAM, a
// CALL's names); a CALL binds a template wherever a cell is bound or a program's name stands.
// A definition may stand inline at its use: a program after its kind in run: and !run:
// (ctrl[...]), an instrument after an event's note (C4.{ad: 9}), a phrase in a play entry
// ([C4, -]+2), and, where a cell is bound, a code body on one line (asm{lda v; sta v+1; rts})
// or, in a command or a slot's default, a quoted expression ('v + 40').

start: "unitracker: " VERSION _NL meta _NL _from_clock? "song:" _NL row+ ending
// the optional lines after meta, in order: a chain of rules, each the lines from one on, so
// that the parser's tables stay linear in their number
_from_clock: clock _NL _from_voices? | _from_voices
_from_voices: voices _NL _from_tempo? | _from_tempo
_from_tempo: tempo _NL _from_slots? | _from_slots
_from_slots: slots _NL _from_order? | _from_order
_from_order: order _NL _from_state? | _from_state
_from_state: state _NL _from_tables? | _from_tables
_from_tables: tables _from_mod? | _from_mod
_from_mod: def_mod _from_restart? | _from_restart
_from_restart: def_restart _from_ins? | _from_ins
_from_ins: def_ins _from_ctrl? | _from_ctrl
_from_ctrl: def_ctrl _from_pw? | _from_pw
_from_pw: def_pw _from_filter? | _from_filter
_from_filter: def_filter _from_init? | _from_init
_from_init: init _NL

// ---- header: clock, voices and tempo only where they differ from PAL, 3 and 6 ---------------

meta: "meta: " _LC meta_item (_SEP meta_item)* "}"
meta_item: META_KEY ": " text
text: TEXT | SQUOTED | DQUOTED

clock: "clock: {cycles_per_tick: " INT ", clock_hz: " INT "}"
voices: "voices: " INT
tempo: "tempo: " (INT | "[" INT ", " INT "]")

// per cell, its slots in firing order, each with its default binding and the events it holds
// and resets on; a cell left out has one slot, named after it, with none
slots: "slots: " _LC slot_cell (_SEP slot_cell)* "}"
slot_cell: CELL ": " _LC slot (_SEP slot)* "}"
slot: NAME ": " _LC slot_mod? "}"
slot_mod: "mod: " (CALL | asm | qexpr) (_SEP slot_hold)? | slot_hold
slot_hold: "hold: " events (_SEP slot_reset)? | slot_reset
slot_reset: "reset: " events
events: _LB HOLD_EVENT (_SEP HOLD_EVENT)* "]"

// the phases of a tick in the order they run, each over the voices in order
order: "order: " _LB PHASE (_SEP PHASE)* "]"

// per cell, in cell order, its state variables in declaration order with their sizes in bytes
state: "state: " _LC state_freq "}"
state_freq: "freq: " state_vars (_SEP state_pw)? | state_pw
state_pw: "pw: " state_vars (_SEP state_cut)? | state_cut
state_cut: "cut: " state_vars
state_vars: _LC state_var (_SEP state_var)* "}"
state_var: STATE_NAME ": " STATE_SIZE

// the tables expressions index as T[k] (0 outside the list) and code reads as T.lo, T.hi
tables: "tables:" _NL ("  " XTABLE ": " intlist _NL)+
intlist: _LB INT (_SEP INT)* "]"

// ---- definitions --------------------------------------------------------------------------

def_mod: "mod:" _NL ("  " SIGNATURE (": " expr _NL | ": |" _NL code))+
def_restart: "restart:" _NL ("  " (RESTART | PROGRAM_SIG) ": " program _NL)+
def_ins: "ins:" _NL ("  " INS ": " instrument _NL)+
def_ctrl: "ctrl:" _NL ("  " (CTRL | PROGRAM_SIG) ": " program _NL)+
def_pw: "pw:" _NL ("  " (PW | PROGRAM_SIG) ": " modulation _NL)+
def_filter: "filter:" _NL ("  " (FILTER | PROGRAM_SIG) ": " modulation _NL)+
def_phrase: "      phrase:" _NL ("        " PHRASE ": " phrase _NL)+

// one event per voice: the state after init, a step of no duration before the first tick
init: "init: " _LB event (_SEP event)* "]"

// ---- timeline -----------------------------------------------------------------------------

row: "  - def:" _NL def_phrase "    play: " plays _NL
   | "  - play: " plays _NL
ending: "  - end" _NL | "  - {loop: " INT "}" _NL
plays: _LB play (_SEP play)* "]"
play: (PHRASE | phrase) SIGNED? | CONT | END

// ---- instruments and programs: each key chain the keys from one on, in the grammar's order --

instrument: _LC ins_ad "}"
ins_ad: "ad: " INT (_SEP ins_sr)? | ins_sr
ins_sr: "sr: " INT (_SEP ins_ctrl)? | ins_ctrl
ins_ctrl: "ctrl: " (CTRL | CALL | program) (_SEP ins_pw)? | ins_pw
ins_pw: SLOT? "pw: " (PW | NONE | modulation) (_SEP ins_pw)? | ins_filter
ins_filter: SLOT? "filter: " (FILTER | NONE | modulation) (_SEP ins_filter)? | ins_freq
ins_freq: SLOT? "freq: " (NONE | _binding) (_SEP ins_freq)? | ins_restart
ins_restart: "restart: " (RESTART | CALL | program)

// a program: its rows in the order they run, then its end or its loop
program: _LB (row_ _SEP)* (END | _LC LOOP INT "}") "]"
// a pulse or filter program that is one binding is written as that binding
modulation: program | _binding
_binding: CALL | asm | fexpr
_int: INT | PARAM

row_: _LC "}" | _LC row_wait "}"
row_wait: "wait: " _int (_SEP row_hold)? | row_hold
row_hold: "hold: " _int (_SEP row_ctrl)? | row_ctrl
row_ctrl: "ctrl: " ctrl_value (_SEP row_gate)? | row_gate
row_gate: "gate: " _int (_SEP row_note)? | row_note
row_note: "note: " note_value (_SEP row_ad)? | row_ad
row_ad: "ad: " _int (_SEP row_sr)? | row_sr
row_sr: "sr: " _int (_SEP row_pw)? | row_pw
row_pw: SLOT? "pw: " cell_value (_SEP row_pw)? | row_cut
row_cut: SLOT? "cut: " cell_value (_SEP row_cut)? | row_res
row_res: "res: " _int (_SEP row_route)? | row_route
row_route: "route: " route_value (_SEP row_mode)? | row_mode
row_mode: "mode: " _int (_SEP row_freq)? | row_freq
row_freq: SLOT? "freq: " cell_value (_SEP row_freq)? | row_run
row_run: "run: " (_program_ref | run_program) (_SEP row_vol)? | row_vol
row_vol: "vol: " _int

ctrl_value: INT | CTRLMASK | PARAM
note_value: SIGNED | NOTE | REL_PARAM
cell_value: _binding | NONE | HOLD
route_value: _int | ROUTE_ADD | ROUTE_ADD_MASK INT | ROUTE_REMOVE | ROUTE_REMOVE_MASK INT "'"
// a program's name, or a call of a program template, whose section gives its kind
_program_ref: CTRL | PW | FILTER | CALL
// an inline program after its kind
run_program: PROGRAM_KIND program

// ---- events: the commands a chain in the grammar's order ---------------------------------

phrase: _LB event (_SEP event)* "]"
event: NOTE_ATOM ("." (INS | instrument))? cmd_run keep_pw keep_filter ("*" INT)?
cmd_run: "!run:" (_program_ref | run_program | NONE) cmd_pw | cmd_pw
cmd_pw: CMD_PW (INT | _command) cmd_pw | cmd_ad
cmd_ad: "!ad:" INT cmd_sr | cmd_sr
cmd_sr: "!sr:" INT cmd_ctrl | cmd_ctrl
cmd_ctrl: "!ctrl:" INT cmd_resfilt | cmd_resfilt
cmd_resfilt: "!resfilt:" INT "/" INT cmd_mode | cmd_mode
cmd_mode: "!mode:" INT cmd_vol | cmd_vol
cmd_vol: "!vol:" INT cmd_cut | cmd_cut
cmd_cut: CMD_CUT (INT | _command) cmd_cut | cmd_tempo
cmd_tempo: "!tempo:" INT ("/" INT)? cmd_vtempo | cmd_vtempo
cmd_vtempo: "!vtempo:" INT ("/" INT)? cmd_freq | cmd_freq
cmd_freq: CMD_FREQ (SIGNED | INT | _command) cmd_freq | cmd_legato
cmd_legato: LEGATO |
_command: CALL | asm | qexpr | NONE | HOLD
keep_pw: KEEP_PW |
keep_filter: KEEP_FILTER |

// ---- expressions (unitracker_grammar.expr) -------------------------------------------------

// plain in a block mapping; in a flow collection plain, or in quotes when it contains a comma
fexpr: expr | "'" expr "'"
// a command's or a slot default's expression, always quoted
qexpr: "'" expr "'" -> fexpr
expr: term (ADD term)*
term: factor (MUL factor | FLOORDIV factor | MOD factor)*
factor: INT | SIGNED | V | PHI | N | EVENT_NOTE | PARAM
      | F expr ")" | XTABLE "[" expr "]"
      | ABS expr ")" | MIN expr _SEP expr ")" | MAX expr _SEP expr ")"
      | "(" expr ")" | "(" expr CMP expr ")"
      | NEG factor

// ---- code (unitracker_grammar.code): a label, or a mnemonic with its operand ---------------

code: ("    " (code_label | code_op) _NL)+
// an anonymous code body on one line, its statements separated by "; "
asm: _ASM (code_label | code_op) ("; " (code_label | code_op))* "}"
code_label: NAME ":"
code_op: NAME (" " (code_imm | code_mem))?
code_imm: "#" (INT | BYTE? NAME)
code_mem: (NAME | TABLE_BYTE) OFFSET? INDEX?

// ---- terminals --------------------------------------------------------------------------

VERSION: "2.0"
META_KEY: "title" | "author" | "released"
CELL: "freq" | "pw" | "cut"
PHASE: "events" | "ctrl" | "pulse" | "filter" | "freq" | "pw" | "cut" | "read"
HOLD_EVENT: /(?:step|last|read|note|legato)(?:-[1-9]\d*)?|row(?:\.[a-z]+)?/
PROGRAM_KIND: /(?:ctrl|pw|filter)(?=\[)/
_ASM.2: "asm{"
SLOT: /[a-z][a-z0-9_]*\./
CMD_PW: /!(?:[a-z][a-z0-9_]*\.)?pw:/
CMD_CUT: /!(?:[a-z][a-z0-9_]*\.)?cut:/
CMD_FREQ: /!(?:[a-z][a-z0-9_]*\.)?freq:/
// a template's parameter: a lowercase name, but a record's name (pw1, c1, f1, ...) or a call's
PARAM: /(?!(?:pw|[cfipr])\d+\b)[a-z][a-z0-9_]*\b(?!\()/
REL_PARAM: /[+-](?!(?:pw|[cfipr])\d+\b)[a-z][a-z0-9_]*/
XTABLE: /[A-EG-MO-Z][A-Za-z]*/
INT: /0|[1-9]\d*/
SIGNED: /[+-](?:0|[1-9]\d*)/
CTRLMASK: /(?:0|[1-9]\d*)?\^(?:0|[1-9]\d*)/
NOTE: /[A-G]#?-?\d+/
NOTE_ATOM: /[A-G]#?-?\d+|-|off|on/
INS: /i\d+/
CTRL: /c\d+/
PW: /pw\d+/
FILTER: /f\d+/
RESTART: /r\d+/
PHRASE: /p\d+/
TEXT: /[^\s,\[\]{}'"#&*!|>%@`][^,\[\]{}]*/
SQUOTED: /'(?:[^']|'')*'/
DQUOTED: /"(?:[^"\\]|\\.)*"/
NAME: /[a-z][a-z0-9_]*/
STATE_NAME: /(?!(?:v|phi|nn|ne|a|x|y)\b)[a-z][a-z0-9_]*/
STATE_SIZE: /[12]\b/
TABLE_BYTE: /(?:F|[A-EG-MO-Z][A-Za-z]*)\.(?:lo|hi)/
// a modulator template's key: its parameters none of the code's symbols
SIGNATURE: /[a-z][a-z0-9_]*\((?:(?!(?:v|phi|nn|ne|a|x|y)\b)[a-z][a-z0-9_]*(?:, (?!(?:v|phi|nn|ne|a|x|y)\b)[a-z][a-z0-9_]*)*)?\)/
// a program template's key: its parameters none of the names a cell value means otherwise
PROGRAM_SIG: /(?!(?:pw|[cfipr])\d+\()[a-z][a-z0-9_]*\((?:(?!(?:v|n|none|hold|(?:pw|[cfipr])\d+)\b)[a-z][a-z0-9_]*(?:, (?!(?:v|n|none|hold|(?:pw|[cfipr])\d+)\b)[a-z][a-z0-9_]*)*)?\)/
// a call: its arguments integers or, in a program template's rows, its parameters
CALL: /(?!(?:abs|min|max)\()[a-z][a-z0-9_]*\((?:(?:[+-]?(?:0|[1-9]\d*)|[a-z][a-z0-9_]*)(?:,(?:[+-]?(?:0|[1-9]\d*)|[a-z][a-z0-9_]*))*)?\)/
OFFSET: /\+[1-9]\d*/
INDEX: ",x" | ",y"
BYTE: "<" | ">"

CONT: "~"
END: "end"
LOOP: "loop: "
NONE: "none"
HOLD: "hold"
ROUTE_ADD: "+"
ROUTE_ADD_MASK: "+ "
ROUTE_REMOVE: "'-'"
ROUTE_REMOVE_MASK: "'- "
LEGATO: "!legato"
KEEP_PW: "!pw"
KEEP_FILTER: "!filter"
V: "v"
PHI: "φ"
N: "N"
EVENT_NOTE: "n"
F: "F("
ABS: "abs("
MIN: "min("
MAX: "max("
NEG: "-"
MUL: "*"

_NL: "\n"
// a flow collection may wrap after its opening bracket
_LB: /\[(?:\n +)?/
_LC: /\{(?:\n +)?/
_SEP: /,(?: |\n +)/

ADD: /(?: |\n +)[+-](?: |\n +)/
FLOORDIV: /(?: |\n +)\/\/(?: |\n +)/
MOD: /(?: |\n +)%(?: |\n +)/
CMP: /(?: |\n +)(?:==|!=|<=|>=|<|>)(?: |\n +)/
