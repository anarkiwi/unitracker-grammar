// The canonical unitracker document, formats 2.3 to 2.5. A document names no player: everything it plays
// is in it, and its only constants are the note table F(k) (notes.py) at its clock.
// Whitespace is exact and there are no line wraps: a block line holds its whole value. No space
// follows a key's colon or a flow comma; a record is indented by one space, a code block's line
// by a tab; an event's commands are each introduced by a space. A flow expression that contains a
// comma is written in single quotes. Every block line ends with its newline.
// A note is its letter, a sharp's in lower case (c4 is C#4), and its octave; in a phrase a note
// leaves out its octave where it is the previous note's in that phrase ([C4,E,G,C5]), the first
// note always written with its octave (canonical.parse writes each note absolute, C#4).
// The definitions are top-level sections: the templates (mod:, keyed by a SIGNATURE, an
// expression or a code block), then restart:, ins:, ctrl:, pw:, filter: and phrase:; a song row
// holds only its play entries. A program record may be a template keyed by a SIGNATURE whose
// rows read its parameters (PARAM, REL_PARAM, a CALL's names); a CALL binds a template wherever a
// cell is bound or a program's name stands.
// A named definition may stand at its first reference instead of in its section, NAME= or a
// template's SIGNATURE= before its value (use_*). A definition may stand inline at its use: a
// program after its kind in run: (ctrl[...]), an instrument after an event's note
// (C4.{ad:9}), a phrase in a play entry ([C4,-]+2), and, where a cell is bound, a code body on
// one line (asm{lda v; sta v+1; rts}) or, in a command or a slot's default, a quoted expression
// ('v + 40').
// Format 2.3 adds sugar that unitracker_grammar.document.expanded writes in the core: the prelude
// templates (prelude.py) a document calls without defining them, chord names standing for their
// intervals among a call's arguments (chords.py), templates of instruments (called from an event,
// C4.inst(8,120)) and of phrases over notes (called in a play entry, riff(G1,E1)+2), groups in a
// phrase or the song ([...]x2, a volta [body|end1|end2]) and named sections of song items
// (section: s1:[play:[...],s2x2]) the song plays (" - s1", " - s1x2"). A binding written with !
// after it fires once; lag and global are header lines the player reads.
// Format 2.4 adds layers: a voice's concurrent programs of one kind, named in the header
// (layers:{ctrl:[a,b]}) and started by a layer's prefix on an instrument's ctrl, pw or filter
// field (b.ctrl:c7) and on a run (b.run:c7, b.run:none); and a song of one orderlist per voice,
// each with its own ending (" - voice:[p1,p2+2|loop:1]"); and the prelude's restart program an
// instrument's restart calls by its parameters (restart:hr(2,15,0), prelude.PROGRAMS), unless the
// document defines its own. A document is 2.4 exactly where it has a layers line, voice
// orderlists or such a call; without them each kind has one layer, and it is 2.3.
// Format 2.5 adds bindings and stops on every register-driving cell (ctrl, ad, sr, res, route,
// mode and vol as well as freq, pw and cut) in program rows, instrument fields (ad, sr) and
// event commands, with slots, state and a phase of the tick for each; the expression operators
// and functions of playspec; the calls line (the play calls of a frame and which are full); the
// holds line (the events on which a program kind or layer does not advance); and the song cells
// res, route, mode and vol in the global line. A document is 2.5 exactly where it has any of
// them (docs/format-2.5.md).

start: FORMAT _NL meta _NL _from_clock? "song:" _NL (item+ ending | voice+)
// the optional lines after meta, in order: a chain of rules, each the lines from one on, so
// that the parser's tables stay linear in their number
_from_clock: clock _NL _from_voices? | _from_voices
_from_voices: voices _NL _from_tempo? | _from_tempo
_from_tempo: tempo _NL _from_slots? | _from_slots
_from_slots: slots _NL _from_layers? | _from_layers
_from_layers: layers _NL _from_holds? | _from_holds
_from_holds: holds _NL _from_order? | _from_order
_from_order: order _NL _from_state? | _from_state
_from_state: state _NL _from_regs? | _from_regs
_from_regs: regs _NL _from_lag? | _from_lag
_from_lag: lag _NL _from_calls? | _from_calls
_from_calls: calls _NL _from_global? | _from_global
_from_global: global_cells _NL _from_tables? | _from_tables
_from_tables: tables _from_mod? | _from_mod
_from_mod: def_mod _from_restart? | _from_restart
_from_restart: def_restart _from_ins? | _from_ins
_from_ins: def_ins _from_ctrl? | _from_ctrl
_from_ctrl: def_ctrl _from_pw? | _from_pw
_from_pw: def_pw _from_filter? | _from_filter
_from_filter: def_filter _from_phrase? | _from_phrase
_from_phrase: def_phrase _from_section? | _from_section
_from_section: def_section _from_init? | _from_init
_from_init: init _NL

// ---- header: clock, voices and tempo only where they differ from PAL, 3 and 6 ---------------

meta: "meta:" _LC meta_item (_SEP meta_item)* "}"
meta_item: META_KEY ":" text
text: TEXT | SQUOTED | DQUOTED

// clock_hz is the machine's clock, the note table F(k) (notes.py) computed at it
clock: "clock:{cycles_per_tick:" INT ",clock_hz:" INT "}"
voices: "voices:" INT
tempo: "tempo:" (INT | "[" INT "," INT "]")

// per cell, its slots in firing order, each with its default binding and the events it holds
// and resets on; a cell left out has one slot, named after it, with none
slots: "slots:" _LC slot_cell (_SEP slot_cell)* "}"
slot_cell: CELL ":" _LC slot (_SEP slot)* "}"
slot: NAME ":" _LC slot_mod? "}"
slot_mod: "mod:" (CALL | asm | qexpr | use_template) (_SEP slot_hold)? | slot_hold
slot_hold: "hold:" events (_SEP slot_reset)? | slot_reset
slot_reset: "reset:" events
events: _LB HOLD_EVENT (_SEP HOLD_EVENT)* "]"

// per program kind, in kind order, its layers in the order each phase runs them; a kind left
// out has one
layers: "layers:" _LC layers_ctrl "}"
layers_ctrl: "ctrl:" layer_names (_SEP layers_pw)? | layers_pw
layers_pw: "pw:" layer_names (_SEP layers_filter)? | layers_filter
layers_filter: "filter:" layer_names
layer_names: _LB NAME (_SEP NAME)* "]"

// per program kind or layer, the events on which its program does not advance
holds: "holds:" _LC hold_key (_SEP hold_key)* "}"
hold_key: NAME ":" events

// the phases of a tick in the order they run, each over the voices in order
order: "order:" _LB PHASE (_SEP PHASE)* "]"

// per cell, in cell order, its state variables in declaration order with their sizes in bytes
state: "state:" _LC state_freq "}"
state_freq: "freq:" state_vars (_SEP state_pw)? | state_pw
state_pw: "pw:" state_vars (_SEP state_cut)? | state_cut
state_cut: "cut:" state_vars (_SEP state_ctrl)? | state_ctrl
state_ctrl: "ctrl:" state_vars (_SEP state_ad)? | state_ad
state_ad: "ad:" state_vars (_SEP state_sr)? | state_sr
state_sr: "sr:" state_vars (_SEP state_res)? | state_res
state_res: "res:" state_vars (_SEP state_route)? | state_route
state_route: "route:" state_vars (_SEP state_mode)? | state_mode
state_mode: "mode:" state_vars (_SEP state_vol)? | state_vol
state_vol: "vol:" state_vars
state_vars: _LC state_var (_SEP state_var)* "}"
state_var: STATE_NAME ":" STATE_SIZE

// the 25 SID registers' values before tick 0, $D400 first
regs: "regs:" intlist

// the ticks the registers are written after the tick that computes them
lag: "lag:" INT

// the play calls that make one frame of output, and the pattern of which calls are full: a
// reduced call runs no events phase and counts no step or tempo
calls: "calls:" _LC "frame:" INT (_SEP "full:" bits)? "}"
bits: _LB BIT (_SEP BIT)* "]"

// the song cells whose bindings, stops and program belong to the song, not to the voice that set
// them
global_cells: "global:" _LB _global_cut "]"
_global_cut: GCUT (_SEP _global_res)? | _global_res
_global_res: GRES (_SEP _global_route)? | _global_route
_global_route: GROUTE (_SEP _global_mode)? | _global_mode
_global_mode: GMODE (_SEP _global_vol)? | _global_vol
_global_vol: GVOL

// the tables expressions index as T[k] (0 outside the list) and code reads as T.lo, T.hi
tables: "tables:" _NL (" " XTABLE ":" intlist _NL)+
intlist: _LB INT (_SEP INT)* "]"

// ---- definitions --------------------------------------------------------------------------

def_mod: "mod:" _NL (" " SIGNATURE (":" expr _NL | ":|" _NL code))+
def_restart: "restart:" _NL (" " (RESTART | SIGNATURE) ":" program _NL)+
// an instrument or phrase record may be a call of its kind's template
def_ins: "ins:" _NL (" " (INS | SIGNATURE) ":" (instrument | CALL) _NL)+
def_ctrl: "ctrl:" _NL (" " (CTRL | SIGNATURE) ":" program _NL)+
// a pulse or filter record that is one binding is written as that binding
def_pw: "pw:" _NL (" " (PW | SIGNATURE) ":" modulation _NL)+
def_filter: "filter:" _NL (" " (FILTER | SIGNATURE) ":" modulation _NL)+
def_phrase: "phrase:" _NL (" " (PHRASE | SIGNATURE) ":" (phrase | PHRASE_CALL) _NL)+
def_section: "section:" _NL (" " SECTION ":" section _NL)+

// one event per voice: the state after init, a step of no duration before the first tick
init: "init:" _LB event (_SEP event)* "]"

// ---- timeline -----------------------------------------------------------------------------

// a song item: a row of play entries, a section played once or TIMES, or a group of items
item: " - " _item _NL
_item: row | part | song_group
row: "play:" plays
part: (SECTION | use_section) TIMES?
section: _LB _items "]"
_items: _item (_SEP _item)*
// a group: its body TIMES, or its body before each of its endings in turn (a volta)
song_group: _LB items ("|" items)+ "]" | _LB items "]" TIMES
items: _items
ending: " - end" _NL | " - {loop:" INT "}" _NL
// a voice's orderlist: its play entries and groups of them, then its end or the top-level entry
// it loops to; a group begins with "[", so an entry is no inline phrase
voice: " - voice:" _LB _voice_items "|" (END | LOOP INT) "]" _NL
_voice_items: _voice_item (_SEP _voice_item)*
_voice_item: voice_play | voice_group
voice_play: (PHRASE | use_phrase | PHRASE_CALL | use_template) SIGNED?
voice_group: _LB voice_items ("|" voice_items)+ "]" | _LB voice_items "]" TIMES
voice_items: _voice_items
plays: _LB play (_SEP play)* "]"
play: (PHRASE | phrase | use_phrase | PHRASE_CALL | use_template) SIGNED? | CONT | END

// ---- instruments and programs: each key chain the keys from one on, in the grammar's order,
// a cell's keys repeating in the order they apply ----------------------------------------

instrument: _LC ins_ad "}"
ins_ad: SLOT? "ad:" (NONE | _binding | once) (_SEP ins_ad)? | ins_sr
ins_sr: SLOT? "sr:" (NONE | _binding | once) (_SEP ins_sr)? | ins_ctrl
ins_ctrl: SLOT? "ctrl:" (CTRL | CALL | program | use_ctrl | use_template) (_SEP ins_ctrl)? | ins_pw
ins_pw: SLOT? "pw:" (PW | NONE | modulation | use_pw | once) (_SEP ins_pw)? | ins_filter
ins_filter: SLOT? "filter:" (FILTER | NONE | modulation | use_filter | once) (_SEP ins_filter)? | ins_freq
ins_freq: SLOT? "freq:" (NONE | _binding | once) (_SEP ins_freq)? | ins_restart
ins_restart: "restart:" (RESTART | CALL | program | use_restart | use_template)

// a program: its rows in the order they run, then its end or its loop
program: _LB (row_ _SEP)* (END | _LC LOOP INT "}") "]"
modulation: program | _binding
_binding: CALL | asm | fexpr | use_template
// a binding that fires once, then leaves its slot unbound
once: (CALL | asm | qexpr | use_template) "!"
_int: INT | PARAM

row_: _LC "}" | _LC row_wait "}"
row_wait: "wait:" _int (_SEP row_hold)? | row_hold
row_hold: "hold:" _int (_SEP row_ctrl)? | row_ctrl
row_ctrl: SLOT? "ctrl:" cell_value (_SEP row_ctrl)? | row_mask
row_mask: "mask:" _int (_SEP row_gate)? | row_gate
row_gate: "gate:" _int (_SEP row_note)? | row_note
row_note: "note:" note_value (_SEP row_ad)? | row_ad
row_ad: SLOT? "ad:" cell_value (_SEP row_ad)? | row_sr
row_sr: SLOT? "sr:" cell_value (_SEP row_sr)? | row_pw
row_pw: SLOT? "pw:" cell_value (_SEP row_pw)? | row_cut
row_cut: SLOT? "cut:" cell_value (_SEP row_cut)? | row_res
row_res: SLOT? "res:" cell_value (_SEP row_res)? | row_route
row_route: SLOT? "route:" cell_value (_SEP row_route)? | row_route_on
row_route_on: "route_on:" _int (_SEP row_route_off)? | row_route_off
row_route_off: "route_off:" _int (_SEP row_mode)? | row_mode
row_mode: SLOT? "mode:" cell_value (_SEP row_mode)? | row_freq
row_freq: SLOT? "freq:" cell_value (_SEP row_freq)? | row_run
row_run: SLOT? "run:" (_program_ref | run_program) (_SEP row_run)? | row_vol
row_vol: SLOT? "vol:" cell_value (_SEP row_vol)?

note_value: SIGNED | NOTE | REL_PARAM
cell_value: _binding | NONE | HOLD | RESET | once
// a program's name, or a call of a program template, whose section gives its kind
_program_ref: CTRL | PW | FILTER | CALL | use_ctrl | use_pw | use_filter | use_template
// an inline program after its kind
run_program: PROGRAM_KIND program

// ---- events: the commands a chain in the grammar's order ---------------------------------

phrase: _LB _events "]"
_events: _event (_SEP _event)*
_event: event | group
group: _LB body ("|" body)+ "]" | _LB body "]" TIMES
body: _events
// a phrase template's events may stand a parameter for a note
event: (NOTE_ATOM | NOTE_PARAM) ("." (INS | instrument | use_ins | CALL | use_template))? cmd_run keep_pw keep_filter ("*" INT)?
cmd_run: CMD_RUN (_program_ref | run_program | NONE) cmd_run | cmd_pw
cmd_pw: CMD_PW (INT | _command | once) cmd_pw | cmd_ad
cmd_ad: CMD_AD (INT | _command | once) cmd_ad | cmd_sr
cmd_sr: CMD_SR (INT | _command | once) cmd_sr | cmd_ctrl
cmd_ctrl: CMD_CTRL (INT | _command | once) cmd_ctrl | cmd_res
cmd_res: CMD_RES (INT | _command | once) cmd_res | cmd_route
cmd_route: CMD_ROUTE (INT | _command | once) cmd_route | cmd_mode
cmd_mode: CMD_MODE (INT | _command | once) cmd_mode | cmd_vol
cmd_vol: CMD_VOL (INT | _command | once) cmd_vol | cmd_cut
cmd_cut: CMD_CUT (INT | _command | once) cmd_cut | cmd_tempo
cmd_tempo: " tempo:" INT ("/" INT)? cmd_vtempo | cmd_vtempo
cmd_vtempo: " vtempo:" INT ("/" INT)? cmd_freq | cmd_freq
cmd_freq: CMD_FREQ (SIGNED | INT | _command | once) cmd_freq | cmd_legato
cmd_legato: LEGATO |
_command: CALL | asm | qexpr | use_template | NONE | HOLD | RESET
keep_pw: KEEP_PW |
keep_filter: KEEP_FILTER |

// ---- definitions at their first use: a name and "=" before its value where it is first
// referenced, a template's signature and "=" before its body, then its call's arguments; a
// program template's body is a program, after its kind where a run starts it -------------

use_ins: DEF_INS (instrument | CALL | use_template)
use_restart: DEF_RESTART program
use_ctrl: DEF_CTRL program
use_pw: DEF_PW modulation
use_filter: DEF_FILTER modulation
use_phrase: DEF_PHRASE (phrase | PHRASE_CALL | use_template)
use_section: DEF_SECTION section
// a phrase template's call takes notes, each with its octave
use_template: DEF_SIG (asm | qexpr | program | run_program | instrument) ARGS | DEF_SIG phrase NOTE_ARGS

// ---- expressions (unitracker_grammar.expr) -------------------------------------------------

// plain in a block mapping; in a flow collection plain, or in quotes when it contains a comma
fexpr: expr | "'" expr "'"
// a command's or a slot default's expression, always quoted
qexpr: "'" expr "'" -> fexpr
// the operators, loosest first, with playspec's precedence: ||, &&, !, one comparison, |, ^, &,
// the shifts, + -, * // %, and the unary ~ and -
expr: land (OR land)*
?land: lnot (AND lnot)*
?lnot: NOT lnot | cmp
?cmp: bor (CMP bor)?
?bor: bxor (BOR bxor)*
?bxor: band (BXOR band)*
?band: shift (BAND shift)*
?shift: sum (SHIFT sum)*
?sum: term (ADD term)*
term: factor (MUL factor | FLOORDIV factor | MOD factor)*
factor: INT | SIGNED | V | PHI | N | EVENT_NOTE | PARAM
      | F expr ")" | XTABLE "[" expr "]"
      | ABS expr ")" | MIN expr _SEP expr ")" | MAX expr _SEP expr ")"
      | LO expr ")" | HI expr ")" | U8 expr ")" | U16 expr ")" | SX expr ")"
      | ITE expr _SEP expr _SEP expr ")"
      | "(" expr ")"
      | NEG factor | INVERT factor

// ---- code (unitracker_grammar.code): a label, or a mnemonic with its operand ---------------

code: ("\t" (code_label | code_op) _NL)+
// an anonymous code body on one line, its statements separated by "; "
asm: _ASM (code_label | code_op) ("; " (code_label | code_op))* "}"
code_label: NAME ":"
code_op: NAME (" " (code_imm | code_mem))?
code_imm: "#" (INT | BYTE? NAME)
code_mem: (NAME | TABLE_BYTE) OFFSET? INDEX?

// ---- terminals --------------------------------------------------------------------------

META_KEY: "title" | "author" | "released"
GCUT: "cut"
GRES: "res"
GROUTE: "route"
GMODE: "mode"
GVOL: "vol"
BIT: /[01]/
CELL: "freq" | "pw" | "cut" | "ctrl" | "ad" | "sr" | "res" | "route" | "mode" | "vol"
PHASE: "events" | "ctrl" | "pulse" | "filter" | "freq" | "pw" | "cut" | "ctl" | "ad" | "sr"
     | "res" | "route" | "mode" | "vol" | "read"
HOLD_EVENT: /(?:step|last|read|note|legato|event)(?:-[1-9]\d*)?|row(?:\.[a-z]+)?/
PROGRAM_KIND: /(?:ctrl|pw|filter)(?=\[)/
_ASM.2: "asm{"
// a slot's prefix, or a layer's on a program's field or a run
SLOT: /[a-z][a-z0-9_]*\./
FORMAT: /unitracker:2\.[345]/
CMD_RUN: / (?:[a-z][a-z0-9_]*\.)?run:/
CMD_PW: / (?:[a-z][a-z0-9_]*\.)?pw:/
CMD_CUT: / (?:[a-z][a-z0-9_]*\.)?cut:/
CMD_FREQ: / (?:[a-z][a-z0-9_]*\.)?freq:/
CMD_AD: / (?:[a-z][a-z0-9_]*\.)?ad:/
CMD_SR: / (?:[a-z][a-z0-9_]*\.)?sr:/
CMD_CTRL: / (?:[a-z][a-z0-9_]*\.)?ctrl:/
CMD_RES: / (?:[a-z][a-z0-9_]*\.)?res:/
CMD_ROUTE: / (?:[a-z][a-z0-9_]*\.)?route:/
CMD_MODE: / (?:[a-z][a-z0-9_]*\.)?mode:/
CMD_VOL: / (?:[a-z][a-z0-9_]*\.)?vol:/
// a template's parameter: a lowercase name, but a name a template's body or a cell value
// reads otherwise and a record's name (pw1, c1, f1, ...)
_PARAM_NAME: /(?!(?:v|phi|n|nn|ne|none|hold|reset|(?:pw|[cfiprs])\d+)\b)[a-z][a-z0-9_]*\b/
PARAM: _PARAM_NAME /(?!\()/
REL_PARAM: /[+-]/ _PARAM_NAME
// a table's name: a capitalised name but F and N
XTABLE: /(?![FN]\b)[A-Z][A-Za-z]*/
INT: /0|[1-9]\d*/
SIGNED: /[+-](?:0|[1-9]\d*)/
// a note: its letter, a sharp's in lower case, and its octave, which a phrase's note may leave
// out (canonical.parse)
NOTE: /[A-Gacdfg]-?\d+/
NOTE_ATOM: /[A-Gacdfg](?:-?\d+)?|-|off|on/
INS: /i\d+/
CTRL: /c\d+/
PW: /pw\d+/
FILTER: /f\d+/
RESTART: /r\d+/
PHRASE: /p\d+/
SECTION: /s\d+/
// x and a count of 2 or more
TIMES: /x(?:[1-9]\d+|[2-9])/
// a note's parameter: a lowercase name but a note's letter and one a parameter may not be
NOTE_PARAM: /(?![a-g](?:-?\d+)?\b|off\b|on\b|(?:v|phi|n|nn|ne|none|hold|reset|(?:pw|[cfiprs])\d+)\b)[a-z][a-z0-9_]*/
// a phrase template's call: its notes, each with its octave
PHRASE_CALL: /(?!(?:pw|[cfiprs])\d+\()[a-z][a-z0-9_]*\([A-Gacdfg]-?\d+(?:,[A-Gacdfg]-?\d+)*\)/
NOTE_ARGS: /\([A-Gacdfg]-?\d+(?:,[A-Gacdfg]-?\d+)*\)/
TEXT: /[^\s,\[\]{}'"#&*!|>%@`][^,\[\]{}]*/
SQUOTED: /'(?:[^']|'')*'/
DQUOTED: /"(?:[^"\\]|\\.)*"/
NAME: /[a-z][a-z0-9_]*/
STATE_NAME: /(?!(?:v|phi|nn|ne|a|x|y)\b)[a-z][a-z0-9_]*/
STATE_SIZE: /[12]\b/
TABLE_BYTE: /(?!N\.)[A-Z][A-Za-z]*\.(?:lo|hi)/
// a template's key, a modulator's or a program's: its name, no record's, and its parameters
SIGNATURE: /(?!(?:pw|[cfiprs])\d+\(|(?:abs|min|max|lo|hi|u8|u16|sx|ite)\()[a-z][a-z0-9_]*\(/ (_PARAM_NAME ("," _PARAM_NAME)*)? ")"
// a call: its arguments integers or, in a program template's rows, its parameters
CALL: /(?!(?:abs|min|max|lo|hi|u8|u16|sx|ite)\()[a-z][a-z0-9_]*\((?:(?:[+-]?(?:0|[1-9]\d*)|[a-z][a-z0-9_]*)(?:,(?:[+-]?(?:0|[1-9]\d*)|[a-z][a-z0-9_]*))*)?\)/
DEF_INS.2: /i\d+=/
DEF_RESTART.2: /r\d+=/
DEF_CTRL.2: /c\d+=/
DEF_PW.2: /pw\d+=/
DEF_FILTER.2: /f\d+=/
DEF_PHRASE.2: /p\d+=/
DEF_SECTION.2: /s\d+=/
DEF_SIG.2: SIGNATURE "="
// a template call's arguments after its definition
ARGS: /\((?:(?:[+-]?(?:0|[1-9]\d*)|[a-z][a-z0-9_]*)(?:,(?:[+-]?(?:0|[1-9]\d*)|[a-z][a-z0-9_]*))*)?\)/
OFFSET: /[+-][1-9]\d*/
INDEX: ",x" | ",y"
BYTE: "<" | ">"

CONT: "~"
END: "end"
LOOP: "loop:"
NONE: "none"
HOLD: "hold"
RESET: "reset"
// an event's flags, each introduced by a space like a command
LEGATO: / legato(?![\w.:])/
KEEP_PW: / pw(?![\w.:])/
KEEP_FILTER: / filter(?![\w.:])/
V: "v"
PHI: "phi"
N: "N"
EVENT_NOTE: "n"
F: "F("
ABS: "abs("
MIN: "min("
MAX: "max("
NEG: "-"
MUL: "*"

_NL: "\n"
_LB: "["
_LC: "{"
_SEP: ","

ADD: / [+-] /
FLOORDIV: " // "
MOD: " % "
CMP: / (?:==|!=|<=|>=|<|>) /
OR: " || "
AND: " && "
NOT: "!"
BOR: " | "
BXOR: " ^ "
BAND: " & "
SHIFT: / (?:<<|>>) /
INVERT: "~"
LO: "lo("
HI: "hi("
U8: "u8("
U16: "u16("
SX: "sx("
ITE: "ite("
