// The canonical unitracker document: format 1.21 with the init row (anarkiwi/unitracker#165),
// value-or-expression command arguments (anarkiwi/unitracker#172) and no fixed record types
// (anarkiwi/unitracker#126, anarkiwi/unitracker#165). A document names no player: everything it
// plays is in it, and its only constants are the note table F(k) (notes.py) at its clock.
// Whitespace is exact, but a space inside a flow collection or a block scalar may be a line
// wrap (a newline and the continuation indentation); a flow expression that contains a comma
// is written in single quotes. Every block line ends with its newline.
// A modulated cell, freq, pw or cut, takes the same two stops, as a row key and as a command:
// none ends the modulator of its level and the cell's default drives it (F(N) for freq; pw and
// cut hold); hold also ends the program modulator, with pw's pulse or cut's filter slot, and the
// cell holds. Format 1.20 spells pw's hold none and cut's hold filter: none / !filter:none.

start: "unitracker: " VERSION _NL meta _NL (clock _NL)? (voices _NL)? (tempo _NL)? (hold _NL)? tables? (init _NL)? "song:" _NL row+ ending

// ---- header: clock, voices and tempo only where they differ from PAL, 3 and 6 ---------------

meta: "meta: " _LC meta_item (_SEP meta_item)* "}"
meta_item: META_KEY ": " text
text: TEXT | SQUOTED | DQUOTED

clock: "clock: {cycles_per_tick: " INT ", clock_hz: " INT "}"
voices: "voices: " INT
tempo: "tempo: " (INT | "[" INT ", " INT "]")

// the ticks each cell's modulators hold on (ctrl.: those a control-program row sets): events of
// the voice, each k ticks earlier with -k
hold: "hold: " _LC hold_cell (_SEP hold_cell)* "}"
hold_cell: HOLD_CELL ": " _LB HOLD_EVENT (_SEP HOLD_EVENT)* "]"

// the tables expressions index as T[k]: 0 outside the list
tables: "tables:" _NL ("  " XTABLE ": " intlist _NL)+
intlist: _LB INT (_SEP INT)* "]"

// one event per voice: the state after init, a step of no duration before the first tick
init: "init: " _LB event (_SEP event)* "]"

// ---- timeline ---------------------------------------------------------------------------

row: "  - def:" _NL section+ "    play: " plays _NL
   | "  - play: " plays _NL
ending: "  - end" _NL | "  - {loop: " INT "}" _NL
plays: _LB play (_SEP play)* "]"
play: PHRASE SIGNED? | CONT | END

// ---- definitions: each record type once per row, names in first-use order --------------

section: "      restart:" _NL ("        " RESTART ": " program _NL)+
       | "      ins:" _NL ("        " INS ": " instrument _NL)+
       | "      ctrl:" _NL ("        " CTRL ": " program _NL)+
       | "      pw:" _NL ("        " PW ": " modulation _NL)+
       | "      filter:" _NL ("        " FILTER ": " modulation _NL)+
       | "      x:" _NL ("        " X ": " expr _NL)+
       | "      phrase:" _NL ("        " PHRASE ": " phrase _NL)+

instrument: _LC ins_ad "}"
ins_ad: "ad: " (INT) (_SEP ins_sr)? | ins_sr
ins_sr: "sr: " (INT) (_SEP ins_ctrl)? | ins_ctrl
ins_ctrl: "ctrl: " (CTRL | program) (_SEP ins_pw)? | ins_pw
ins_pw: "pw: " (PW | modulation) (_SEP ins_filter)? | ins_filter
ins_filter: "filter: " (FILTER | modulation) (_SEP ins_freq)? | ins_freq
ins_freq: "freq: " (fexpr) (_SEP ins_fn)? | ins_fn
ins_fn: "mod: " NAME (_WB param_bag)? (_SEP ins_restart)? | ins_restart
param_bag: "{" pname_val (_SEP pname_val)* "}"
pname_val: NAME _BSC (SIGNED | INT | NAME | pname_list)
pname_list: "[" (SIGNED | INT) (_SEP (SIGNED | INT))* "]"
_WB: /(?: |\n +)/          // a flow space that may be a line wrap
_BSC: /:(?: |\n +)/        // a bag's colon, a space or a line wrap before its value
ins_restart: "restart: " (RESTART | program)

// a program: its rows in the order they run, then its end or its loop
program: _LB (row_ _SEP)* (END | _LC LOOP INT "}") "]"
// a pulse or filter program that is one expression (a constant is one) is written as that
modulation: program | fexpr

row_: _LC "}" | _LC row_wait "}"
row_wait: "wait: " (INT) (_SEP row_hold)? | row_hold
row_hold: "hold: " (INT) (_SEP row_ctrl)? | row_ctrl
row_ctrl: "ctrl: " (ctrl_value) (_SEP row_gate)? | row_gate
row_gate: "gate: " (INT) (_SEP row_note)? | row_note
row_note: "note: " (note_value) (_SEP row_ad)? | row_ad
row_ad: "ad: " (INT) (_SEP row_sr)? | row_sr
row_sr: "sr: " (INT) (_SEP row_pw)? | row_pw
row_pw: "pw: " (cell_value) (_SEP row_cut)? | row_cut
row_cut: "cut: " (cell_value) (_SEP row_res)? | row_res
row_res: "res: " (INT) (_SEP row_route)? | row_route
row_route: "route: " (route_value) (_SEP row_mode)? | row_mode
row_mode: "mode: " (INT) (_SEP row_freq)? | row_freq
row_freq: "freq: " (cell_value) (_SEP row_run)? | row_run
row_run: "run: " (program_name) (_SEP row_filter)? | row_filter
row_filter: "filter: " (NONE) (_SEP row_vol)? | row_vol
row_vol: "vol: " (INT)

ctrl_value: INT | CTRLMASK
note_value: SIGNED | NOTE
cell_value: fexpr | NONE | HOLD
route_value: INT | ROUTE_ADD | ROUTE_ADD_MASK INT | ROUTE_REMOVE | ROUTE_REMOVE_MASK INT "'"
program_name: CTRL | PW | FILTER

// ---- events -----------------------------------------------------------------------------

phrase: _LB event (_SEP event)* "]"
event: NOTE_ATOM ("." INS)? cmd_run keep_pw keep_filter ("*" INT)?
cmd_run: "!run:" (program_name | NONE) cmd_pw | cmd_pw
cmd_pw: "!pw:" (INT | X | NONE | HOLD) cmd_filter | cmd_filter
cmd_filter: FILTER_NONE cmd_ad | cmd_ad
cmd_ad: "!ad:" INT cmd_sr | cmd_sr
cmd_sr: "!sr:" INT cmd_ctrl | cmd_ctrl
cmd_ctrl: "!ctrl:" INT cmd_resfilt | cmd_resfilt
cmd_resfilt: "!resfilt:" INT "/" INT cmd_mode | cmd_mode
cmd_mode: "!mode:" INT cmd_vol | cmd_vol
cmd_vol: "!vol:" INT cmd_cut | cmd_cut
cmd_cut: "!cut:" (INT | X | NONE | HOLD) cmd_tempo | cmd_tempo
cmd_tempo: "!tempo:" INT ("/" INT)? cmd_vtempo | cmd_vtempo
cmd_vtempo: "!vtempo:" INT ("/" INT)? cmd_freq | cmd_freq
cmd_freq: "!freq:" (X | NONE | HOLD | SIGNED | INT) cmd_set | cmd_set
cmd_set: ("!set " NAME " " (SIGNED | INT))+ cmd_legato | cmd_legato
cmd_legato: LEGATO | 
keep_pw: KEEP_PW |
keep_filter: KEEP_FILTER |

// ---- expressions (docs/modulation/expressions.md) ---------------------------------------

// plain in a block mapping; in a flow collection plain, or in quotes when it contains a comma
fexpr: expr | "'" expr "'"
expr: term (ADD term)*
term: factor (MUL factor | FLOORDIV factor | MOD factor)*
factor: INT | SIGNED | V | PHI | N
      | F expr ")" | XTABLE "[" expr "]"
      | ABS expr ")" | MIN expr _SEP expr ")" | MAX expr _SEP expr ")"
      | "(" expr ")" | "(" expr CMP expr ")"
      | NEG factor

// ---- terminals --------------------------------------------------------------------------

VERSION: /\d+\.\d+/
META_KEY: "title" | "author" | "released"
HOLD_CELL: /(?:ctrl\.)?(?:freq|pw|cut)/
HOLD_EVENT: /(?:step|last|read|note|legato)(?:-[1-9]\d*)?|row/
XTABLE: /[A-EG-MO-Z][A-Za-z]*/
INT: /\d+/
SIGNED: /[+-]\d+/
CTRLMASK: /\d*\^\d+/
NOTE: /[A-G]#?-?\d+/
NOTE_ATOM: /[A-G]#?-?\d+|-|off|on/
INS: /i\d+/
CTRL: /c\d+/
PW: /pw\d+/
FILTER: /f\d+/
RESTART: /r\d+/
X: /x\d+/
PHRASE: /p\d+/
TEXT: /[^\s,\[\]{}'"#&*!|>%@`][^,\[\]{}]*/
SQUOTED: /'(?:[^']|'')*'/
DQUOTED: /"(?:[^"\\]|\\.)*"/
NAME: /[a-z][a-z0-9_]*/

CONT: "~"
END: "end"
LOOP: "loop: "
NONE: "none"
HOLD: "hold"
ROUTE_ADD: "+"
ROUTE_ADD_MASK: "+ "
ROUTE_REMOVE: "'-'"
ROUTE_REMOVE_MASK: "'- "
FILTER_NONE: "!filter:none"
LEGATO: "!legato"
KEEP_PW: "!pw"
KEEP_FILTER: "!filter"
OSC_MOD: "symmetric" | "ramp" | "approach"
V: "v"
PHI: "φ"
N: "N"
F: "F("
ABS: "abs("
MIN: "min("
MAX: "max("
NEG: "-"
MUL: "*"

_NL: "\n"
// a flow collection may wrap after its opening bracket
_LB: /\[(?:\n +)?/
_LC: /\{(?:\n +)?/
_SEP: /,(?: |\n +)/

ADD: /(?: |\n +)[+-](?: |\n +)/
FLOORDIV: /(?: |\n +)\/\/(?: |\n +)/
MOD: /(?: |\n +)%(?: |\n +)/
CMP: /(?: |\n +)(?:==|!=|<=|>=|<|>)(?: |\n +)/
